# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Configure ONE provider.

# Option A — Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional; must be on a domain verified in Resend. Defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=

# Option B — Formspree (https://formspree.io), the ID after https://formspree.io/f/
FORMSPREE_FORM_ID=

# Optional: overrides site.domain in data/site.ts, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
